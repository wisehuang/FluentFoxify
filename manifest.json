{
  "manifest_version": 2,
  "name": "FluentFoxify",
  "version": "1.3",
  "description": "Rewrite English, or translate Chinese, into clear and natural English in the tone you pick, from the toolbar or the right-click menu. Uses your own OpenAI API key.",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "https://api.openai.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "background": {
    "scripts": ["shared.js", "background.js"],
    "persistent": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
